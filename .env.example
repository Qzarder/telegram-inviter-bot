# Обязательные настройки
BOT_TOKEN=PASTE_BOT_TOKEN_HERE
API_ID=123456
API_HASH=PASTE_API_HASH_HERE
ACCOUNT_IMPORT_DIR=account_import
AUTO_IMPORT_SYNC_ENABLED=true
AUTO_IMPORT_SYNC_INTERVAL=300

# Настройки пауз между инвайтами (в секундах)
MIN_DELAY=300
MAX_DELAY=600
INVITES_PER_ACC=10
INVITE_MAX_PER_SESSION=1
INVITE_MAX_CONCURRENT=1
INVITE_BAN_COOLDOWN_HOURS=48
FLOOD_WAIT_EXTRA_SECONDS=60
INVITE_CASCADE_PAUSE_SECONDS=60
INVITE_CIRCUIT_BREAKER_THRESHOLD=2
INVITE_CIRCUIT_BREAKER_WINDOW_SECONDS=600
INVITE_CIRCUIT_BREAKER_PAUSE_SECONDS=3600
INVITE_MIN_READY_ACCOUNTS=3
INVITE_DEFER_USER_HOURS=48
INVITE_RAMP_UP_ENABLED=true
INVITE_VERIFY_ENABLED=false
INVITE_USE_SEARCH_REQUEST=false
INVITE_ENTITY_CACHE_ENABLED=true
SESSION_PROXY_STICKY_ENABLED=true
PROXY_MAX_ACCOUNTS_PER_IP=5
APPROVAL_CHECK_INTERVAL=120
PROXY_CHECK_INTERVAL=30
PROXY_CHECK_TIMEOUT=8
SPAMBOT_CHECK_ENABLED=true
SPAMBOT_TIMEOUT_SECONDS=25
SPAMBOT_LIMITED_COOLDOWN_HOURS=24

# Фоновый прогрев (warmer)
WARMER_ENABLED=true
WARMER_SCAN_INTERVAL=45
WARMER_STEP_DELAY_MIN=4
WARMER_STEP_DELAY_MAX=12
WARMER_ACCOUNT_PAUSE_MIN=20
WARMER_ACCOUNT_PAUSE_MAX=60
WARMER_MANUAL_START_PERCENT=80
WARMER_PREWARMED_THRESHOLD=15
WARMER_PROXY_WARMUP_MIN_ACTIONS=5
WARMER_CHANNELS_PER_ACCOUNT=25
WARMER_CHANNEL_DISTRIBUTION_DAYS=3
WARMER_MAX_CHANNELS_PER_PASS=2

# Прокси (если не нужен, оставь USE_PROXY=false)
USE_PROXY=false
PROXY_TYPE=socks5
PROXY_ADDR=127.0.0.1
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=

# Гео-прокси:
# 1) включи USE_PROXY=true
# 2) создай country_proxies.json по шаблону country_proxies.example.json
# Бот выберет прокси по названию папки страны в sessions/<country>/*.session
